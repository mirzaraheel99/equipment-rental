# Copy to .env and adjust for local development. Never commit real secrets.

NODE_ENV=development
APP_ENV=local

# Ports
WEB_PORT=3000
CUSTOMER_PORTAL_PORT=3100
API_PORT=4000
WORKER_PORT=4100
STORYBOOK_PORT=6006

# Public (exposed to the browser — must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Database
DATABASE_URL=postgresql://erms:erms_local_dev@localhost:5432/erms?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO, S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=erms-local
S3_ACCESS_KEY_ID=erms_local
S3_SECRET_ACCESS_KEY=erms_local_dev_secret

# Mail (Mailpit)
MAIL_HOST=localhost
MAIL_PORT=1025

# Observability
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
